# Server-only Google AI Studio API key. Never prefix with VITE_ or commit .env.
GEMINI_API_KEY=

# Local defaults need no login. Render sets hosted mode and its public URL.
# GHOSTCOMMIT_HOSTED=true
# GHOSTCOMMIT_PUBLIC_URL=https://ghostcommit.example.com
# GHOSTCOMMIT_USERNAME=admin
# GHOSTCOMMIT_PASSWORD=choose-a-unique-password-at-least-16-characters
# GHOSTCOMMIT_DATA=/var/data/ghostcommit
